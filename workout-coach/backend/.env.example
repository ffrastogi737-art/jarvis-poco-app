# Copy to .env (never commit it) or set these in your host's secret manager.
# Long random string; the app sends it as "Authorization: Bearer <APP_TOKEN>". Generate: openssl rand -hex 32
APP_TOKEN=
PORT=8787
# gemini | groq | openrouter — used when the app doesn't specify one
DEFAULT_PROVIDER=gemini

# Configure at least one provider. Model IDs are deliberately NOT defaulted: copy a current
# model ID from the provider's own model list (they change and get deprecated).
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Cost controls
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_LIMIT=200
DAILY_TOKEN_LIMIT=200000
MAX_OUTPUT_TOKENS=800
REQUEST_TIMEOUT_MS=25000
USAGE_FILE=./usage.json
